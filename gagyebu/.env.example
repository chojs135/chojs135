# Claude API 키 (https://console.anthropic.com) — 문서/사진 자동 분석에 필요
ANTHROPIC_API_KEY=
# 로그인 토큰 서명용 비밀값. 아무 긴 랜덤 문자열 (예: openssl rand -hex 32)
JWT_SECRET=
# (선택) 구글 시트 연동: 서비스 계정 키 JSON 파일 경로 또는 JSON 문자열 그대로
GOOGLE_SERVICE_ACCOUNT_KEY=
# (선택) 기본 시트 ID. 앱 설정 화면에서 시트 주소를 붙여 넣어도 된다.
GOOGLE_SHEET_ID=1PTb4_1YVu94UzckbFCbVBlmivFdBcl-JIlPIRYWLsDc
# (선택) DB 저장 위치. 기본값 server/data
DATA_DIR=
PORT=3001
# (선택) 하루 한 번 DB 사본을 남길 폴더. 구글 드라이브/원드라이브 동기화 폴더로 두면 PC 고장에도 안전
BACKUP_DIR=
# 새 가계부는 서버에 처음 한 번만 만들 수 있다. 정말 하나 더 만들어야 할 때만 true
ALLOW_NEW_HOUSEHOLD=
